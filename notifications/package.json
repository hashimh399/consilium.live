{
  "name": "consilium-notifications",
  "version": "0.1.0",
  "private": true,
  "description": "Listens for RSA confirmations from the Consilium voice agent and notifies the customer and the dealership manager",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "ioredis": "^5.4.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
