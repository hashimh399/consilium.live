# --- runtime ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- redis ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_CHANNEL=voice_agent_events

# --- delivery ---
# mock = log the fully-built request without leaving the process (default)
# http = actually call the provider
DELIVERY_TRANSPORT=mock
# Simulated failure rate for the mock transport, 0..1. Useful for exercising retries.
MOCK_FAILURE_RATE=0
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_TIMEOUT_MS=8000

# --- whatsapp: "meta" (WhatsApp Cloud API) or "twilio" ---
WHATSAPP_PROVIDER=meta
WHATSAPP_FROM=+911141234567
# meta
META_PHONE_NUMBER_ID=000000000000000
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
# twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- email: "sendgrid" or "smtp" ---
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=alerts@consilium.live
MANAGER_EMAIL=manager@consilium.live
SENDGRID_API_KEY=
SMTP_URL=smtp://127.0.0.1:1025
