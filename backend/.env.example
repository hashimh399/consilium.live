# ── Groq (LLM) ────────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Comma-separated pool. A 429 cools that key for Groq's retry window and uses the next free key.
GROQ_API_KEYS=
# Used for the live voice loop when a Groq key is set. Otherwise DeepSeek streams.
GROQ_MODEL=openai/gpt-oss-20b

# ── Deepgram (STT + TTS) ──────────────────────────────────────
# Get a key at https://console.deepgram.com  ($200 free credit)
DEEPGRAM_API_KEY=

# ── Twilio ────────────────────────────────────────────────────
# Get these at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── App ───────────────────────────────────────────────────────
# Public URL Twilio can reach (e.g. https://xxxx.trycloudflare.com).
# Leave empty to derive from the incoming request host.
PUBLIC_BASE_URL=

# Optional overrides
DATABASE_URL=sqlite:///./consilium_voice_agent.db
LLM_MODEL=llama-3.3-70b-versatile
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-orion-en

# Cartesia Sonic replaces Deepgram for speech-out. Deepgram remains the transcriber.
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4

# Live events. The dashboard and notification service subscribe to this channel.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CHANNEL=voice_agent_events

# ANI directory, queried before the greeting.
CALLER_LOOKUP_URL=http://localhost:8080/api/caller-lookup
