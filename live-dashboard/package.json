{
  "name": "consilium-live-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Live call dashboard gateway for the Consilium voice agent",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "smoke:http": "node scripts/smoke-http.mjs",
    "smoke:redis": "npm run build && node scripts/smoke-redis.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
